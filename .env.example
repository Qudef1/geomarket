ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://geomarket:geomarket@postgres:5432/geomarket
REDIS_URL=redis://redis:6379/0
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
HTTP_USER_AGENT=GeoMarketAI/0.1 (+https://github.com/YOUR_USERNAME/geomarket; contact=YOUR_EMAIL)
CACHE_TTL_SECONDS=3600
CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$
